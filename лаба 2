#include <iostream>
#include <random>

using namespace std;

mt19937 gen(0);

const int N = 1e4 + 5;
const int inf = 2e9;

int a[N];

int main() {
    cout << "size: ";
    
    int n;
    cin >> n;

    if (n > N) {
        cout << "NONONO Mstr fish";

        return 0;
    }

    cout << "\ntype (1 - random): ";

    int type;
    cin >> type;

    if (type) {
        cout << "\ninterval: ";

        int l, r;
        cin >> l >> r;

        for (int i = 0; i < n; ++i) 
            a[i] = gen() % (r - l + 1) + l;

        cout << '\n';
        for (int i = 0; i < n; ++i) 
            cout << a[i] << ' ';
    }
    else {
        cout << "\narray: ";

        for (int i = 0; i < n; ++i) 
            cin >> a[i];

        string s;
        getline(cin, s);

        //cerr << "hui";

        while (s.size() && s[0] == ' ') s.erase(0, 1);

        if (s.size()) {
            cout << "OMG!!! nadta shmat!";

            return 0;
        }
    }

    int ind = 0;

    for (int i = 1; i < n; ++i) 
        if (abs(a[i]) > abs(a[ind])) ind = i;

    bool f = 0;
    int sum = 0;

    for (int i = 0; i < n; ++i) {
        if (f) sum += a[i];
        if (a[i] < 0) f = 1;
    }

    cout << "\nP: ";

    int P, k = 0;
    cin >> P;

    for (int i = n - 1; i >= 0; --i) {
        if (a[i] != P) continue;

        for (int j = i; j < n - 1; ++j) 
            a[j] = a[j + 1];
        
            ++k;
    }

    for (int i = n - k; i < n; ++i) 
        a[i] = 0;

    cout << "\nindex max abs: " << ind;
    cout << "\nsum: " << sum << '\n'; 

    for (int i = 0; i < n; ++i) 
        cout << a[i] << ' ';

    return 0;
}
