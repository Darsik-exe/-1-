#include <iostream>
#include <iomanip>
#include <math.h>

using namespace std;

int main() {
    int k;
    cin >> k;

    long double x;
    long double y;
    cin >> x;
    
    long double c = log((1 + x) / (1 - x));

    y = x * x;
    long double ans = 0;

    for (int i = 0; i < 1000; ++i) {
        ans += x / (i * 2 + 1);
        x *= y;
    }

    ans *= 2;


    cout << fixed << setprecision(k + 1) << c << '\n';
    cout << fixed << setprecision(k + 1) << ans << '\n';

    return 0;
}
