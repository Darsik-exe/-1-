#include <iostream>
#include <iomanip>
#include <math.h>

using namespace std;

int main() {
    int k;
    cin >> k;

    long double x;
    long double y;
    cin >> x;
    
    long double c = log((1 + x) / (1 - x));

    y = x * x;
    long double ans = 0;

    for (int i = 0; i < 1000; ++i) {
        ans += x / (i * 2 + 1);
        x *= y;
    }

    ans *= 2;


    cout << fixed << setprecision(k + 1) << c << '\n';
    cout << fixed << setprecision(k + 1) << ans << '\n';

    long double con = 1;

    for (int i = 0; i < k; ++i) 
        con /= 10;

    if (c - ans >= con) cout << "my mensh";
    else if (ans - c >= con) cout << "my bolsh";
        else cout << "norm";

    return 0;
}
